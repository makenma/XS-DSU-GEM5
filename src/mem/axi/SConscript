# -*- mode:python -*-

Import('*')

# Keep the AXI endpoint, helpers, and tests completely out of all legacy Ruby
# and ISA builds.
if env['CONF']['PROTOCOL'] != 'AXI_MESH':
    Return()

SimObject('AxiGarnetEndpoint.py', sim_objects=[
    'AxiInitiatorAdapter',
    'AxiTargetAdapter',
])

Source('axi_garnet_endpoint.cc')
Source('axi_packetization.cc')
DebugFlag('AxiGarnetProbe')

GTest('axi_packetization.test',
      'axi_packetization.test.cc', 'axi_packetization.cc')
