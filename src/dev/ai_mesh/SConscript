import gem5_scons
Import('*')
if env['CONF']['PROTOCOL'] != 'AXI_MESH':
    Return()
with gem5_scons.Configure(env.Clone(LIBS=[])) as conf:
    if not conf.CheckPkgConfig('isl'):
        gem5_scons.error('AI Mesh requires libisl-dev with pkg-config metadata')
    conf.env.Append(LIBS=['isl'])
    isl_linked = conf.TryLink('\n#include <isl/ctx.h>\n#include <isl/map.h>\n#include <isl/set.h>\nint\nmain()\n{\n    isl_ctx *context = isl_ctx_alloc();\n    isl_set *set = isl_set_read_from_str(context, "{ [i] }");\n    isl_map *map = isl_map_read_from_str(context, "{ [i] -> [i] }");\n    isl_set_free(set);\n    isl_map_free(map);\n    isl_ctx_free(context);\n    return 0;\n}\n', '.cc')
    if not isl_linked:
        gem5_scons.error('AI Mesh requires libisl-dev headers and linker support')
isl = SourceLib('isl', tags={'gem5 lib', 'ai mesh isl'})
