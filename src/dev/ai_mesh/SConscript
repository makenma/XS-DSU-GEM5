# -*- mode:python -*-

import gem5_scons

Import('*')

# The AI Mesh dummy core stack only exists in the AXI_MESH protocol build,
# mirroring the guard used by src/mem/axi/SConscript.
if env['CONF']['PROTOCOL'] != 'AXI_MESH':
    Return()

with gem5_scons.Configure(env) as conf:
    if not conf.CheckPkgConfig('isl'):
        error('AI Mesh requires libisl-dev with pkg-config metadata')
    original_libs = list(conf.env['LIBS'])
    conf.env.Append(LIBS=['isl'])
    isl_linked = conf.TryLink(r'''
#include <isl/ctx.h>
#include <isl/map.h>
#include <isl/set.h>
int
main()
{
    isl_ctx *context = isl_ctx_alloc();
    isl_set *set = isl_set_read_from_str(context, "{ [i] }");
    isl_map *map = isl_map_read_from_str(context, "{ [i] -> [i] }");
    isl_set_free(set);
    isl_map_free(map);
    isl_ctx_free(context);
    return 0;
}
''', '.cc')
    conf.env.Replace(LIBS=original_libs)
    if not isl_linked:
        error('AI Mesh requires libisl-dev headers and linker support')

isl = SourceLib('isl', tags={'gem5 lib', 'ai mesh isl'})

