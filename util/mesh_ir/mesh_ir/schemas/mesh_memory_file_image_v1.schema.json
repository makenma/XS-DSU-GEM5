{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh-memory-file-image-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "program_semantic_sha256",
    "architecture_sha256",
    "spans"
  ],
  "properties": {
    "schema": {
      "const": "mesh-memory-file-image-v1"
    },
    "program_semantic_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "architecture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "path",
          "offset",
          "size",
          "sha256"
        ],
        "properties": {
          "address": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
