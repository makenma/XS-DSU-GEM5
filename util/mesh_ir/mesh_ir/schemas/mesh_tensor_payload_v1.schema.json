{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh-tensor-payload-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "export_sha256",
    "export_semantic_sha256",
    "byteorder",
    "payload_file",
    "payload_sha256",
    "tensors"
  ],
  "properties": {
    "schema": {
      "const": "mesh-tensor-payload-v1"
    },
    "export_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "export_semantic_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byteorder": {
      "const": "little"
    },
    "payload_file": {
      "type": "string",
      "minLength": 1
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "dtype",
          "shape",
          "offset",
          "size",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "PARAMETER",
              "BUFFER",
              "CONSTANT_TENSOR",
              "USER_INPUT"
            ]
          },
          "dtype": {
            "enum": [
              "FP32",
              "FP16",
              "BF16",
              "INT8",
              "INT32"
            ]
          },
          "shape": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            }
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
