    "softmax_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "semantic_attrs", "tile", "cost", "algorithm"], "properties": {"kind": {"const": "SoftmaxKernelAttrs"}, "semantic_attrs": {"$ref": "mesh-graph-v1#/$defs/softmax_attrs"}, "tile": {"$ref": "#/$defs/tile"}, "cost": {"$ref": "#/$defs/cost"}, "algorithm": {"const": "STABLE_MAX_SUM"}}},
    "norm_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "graph_opcode", "semantic_attrs", "tile", "cost", "algorithm"], "properties": {"kind": {"const": "NormKernelAttrs"}, "graph_opcode": {"enum": ["LAYERNORM", "RMSNORM"]}, "semantic_attrs": {"$ref": "mesh-graph-v1#/$defs/norm_attrs"}, "tile": {"$ref": "#/$defs/tile"}, "cost": {"$ref": "#/$defs/cost"}, "algorithm": {"enum": ["LAYER_NORM", "RMS_NORM"]}}},
    "collective_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "participants", "algorithm", "chunk_bytes", "reduce_kind", "partial_sum_id"], "properties": {"kind": {"const": "ALL_REDUCE"}, "participants": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/hardware_core"}, "uniqueItems": true}, "algorithm": {"enum": ["AUTO", "RING", "TREE"]}, "chunk_bytes": {"$ref": "#/$defs/u64"}, "reduce_kind": {"const": "SUM"}, "partial_sum_id": {"$ref": "#/$defs/id"}}},
    "local_reduce_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "reduce_kind", "partial_sum_id", "tile", "cost"], "properties": {"kind": {"const": "LocalReduceAttrs"}, "reduce_kind": {"const": "SUM"}, "partial_sum_id": {"$ref": "#/$defs/id"}, "tile": {"$ref": "#/$defs/tile"}, "cost": {"$ref": "#/$defs/cost"}}},
