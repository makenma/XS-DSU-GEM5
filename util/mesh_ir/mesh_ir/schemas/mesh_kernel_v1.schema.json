    "barrier_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "participants"], "properties": {"kind": {"const": "BarrierAttrs"}, "participants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hardware_core"}, "uniqueItems": true}}},
    "attrs": {
      "type": "object",
      "required": ["kind"],
      "if": {"required": ["kind"], "properties": {"kind": {"$ref": "#/$defs/alloc_attrs/properties/kind"}}},
      "then": {"$ref": "#/$defs/alloc_attrs"},
      "else": {
        "if": {"required": ["kind"], "properties": {"kind": {"$ref": "#/$defs/view_attrs/properties/kind"}}},
        "then": {"$ref": "#/$defs/view_attrs"},
