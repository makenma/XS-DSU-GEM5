    "memory_space": {"type": "integer", "enum": [1, 2, 3]},
    "blocked_layout": {"type": "object", "additionalProperties": false, "required": ["kind", "block_m", "block_n", "block_k", "minor_to_major"], "properties": {"kind": {"const": "BlockedMnkLayout"}, "block_m": {"$ref": "#/$defs/positive_u64"}, "block_n": {"$ref": "#/$defs/positive_u64"}, "block_k": {"$ref": "#/$defs/positive_u64"}, "minor_to_major": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 2}, "uniqueItems": true}}},
    "tensor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "tensor_id", "producer_computation_id", "alias_root_tensor_id", "storage_offset_elements", "name", "role", "dtype", "shape", "strides", "storage_class", "access", "logical_extent_bytes", "storage_extent_bytes"],
      "properties": {"kind": {"const": "KernelTensor"}, "tensor_id": {"$ref": "#/$defs/id"}, "producer_computation_id": {"$ref": "#/$defs/id_or_zero"}, "synthesized_purpose": {"enum": ["PADDING", "COPY", "ACCUMULATION", "PARTIAL_SUM", "REDUCTION", "DATA_MOVEMENT"]}, "alias_root_tensor_id": {"$ref": "#/$defs/id"}, "storage_offset_elements": {"$ref": "#/$defs/u64"}, "name": {"type": "string", "minLength": 1}, "role": {"$ref": "#/$defs/role"}, "dtype": {"$ref": "#/$defs/dtype"}, "shape": {"$ref": "#/$defs/shape"}, "strides": {"$ref": "#/$defs/shape"}, "storage_class": {"$ref": "#/$defs/storage_class"}, "access": {"$ref": "#/$defs/access"}, "logical_extent_bytes": {"$ref": "#/$defs/u64"}, "storage_extent_bytes": {"$ref": "#/$defs/u64"}, "content_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "computation": {"type": "object", "additionalProperties": false, "required": ["kind", "computation_id", "opcode", "operand_tensor_ids", "result_tensor_id", "attrs"], "properties": {"kind": {"const": "KernelComputation"}, "computation_id": {"$ref": "#/$defs/id"}, "opcode": {"type": "string"}, "operand_tensor_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "result_tensor_id": {"$ref": "#/$defs/id"}, "attrs": {"$ref": "mesh-graph-v1#/$defs/attrs"}}},
    "tensor_lineage": {"type": "object", "additionalProperties": false, "required": ["kind", "tensor_id", "source_value_id"], "properties": {"kind": {"const": "KernelTensorLineage"}, "tensor_id": {"$ref": "#/$defs/id"}, "source_value_id": {"$ref": "#/$defs/id_or_zero"}}},
    "computation_lineage": {"type": "object", "additionalProperties": false, "required": ["kind", "computation_id", "source_op_id", "source_node_id"], "properties": {"kind": {"const": "KernelComputationLineage"}, "computation_id": {"$ref": "#/$defs/id"}, "source_op_id": {"$ref": "#/$defs/id"}, "source_node_id": {"type": "string", "minLength": 1}}},
    "placement": {"type": "object", "additionalProperties": false, "required": ["kind", "placement_id", "core_ids"], "properties": {"kind": {"const": "Placement"}, "placement_id": {"$ref": "#/$defs/id"}, "core_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hardware_core"}, "uniqueItems": true}}},
    "shard": {"type": "object", "additionalProperties": false, "required": ["kind", "shard_id", "tensor_id", "placement_id", "owner_core", "distribution", "global_origin", "padded_local_shape", "valid_shape", "partial_sum_id"], "properties": {"kind": {"const": "TensorShard"}, "shard_id": {"$ref": "#/$defs/id"}, "tensor_id": {"$ref": "#/$defs/id"}, "placement_id": {"$ref": "#/$defs/id"}, "owner_core": {"$ref": "#/$defs/hardware_core"}, "distribution": {"enum": ["PARTITIONED", "REPLICATED", "PARTIAL_SUM"]}, "global_origin": {"$ref": "#/$defs/shape"}, "padded_local_shape": {"$ref": "#/$defs/shape"}, "valid_shape": {"$ref": "#/$defs/shape"}, "partial_sum_id": {"$ref": "#/$defs/id_or_zero"}}},
    "partial_sum": {"type": "object", "additionalProperties": false, "required": ["kind", "partial_sum_id", "computation_id", "semantic_result_tensor_id", "accumulator_tensor_id", "placement_id"], "properties": {"kind": {"const": "PartialSumDefinition"}, "partial_sum_id": {"$ref": "#/$defs/id"}, "computation_id": {"$ref": "#/$defs/id"}, "semantic_result_tensor_id": {"$ref": "#/$defs/id"}, "accumulator_tensor_id": {"$ref": "#/$defs/id"}, "placement_id": {"$ref": "#/$defs/id"}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["kind", "object_id", "storage_tensor_id", "owner_core", "memory_space", "shape", "strides", "footprint_bytes", "alignment_bytes", "persistent", "buffer_index"], "properties": {"kind": {"const": "BufferObject"}, "object_id": {"$ref": "#/$defs/id"}, "storage_tensor_id": {"$ref": "#/$defs/id"}, "owner_core": {"$ref": "#/$defs/core"}, "memory_space": {"$ref": "#/$defs/memory_space"}, "shape": {"$ref": "#/$defs/shape"}, "strides": {"$ref": "#/$defs/shape"}, "footprint_bytes": {"$ref": "#/$defs/u64"}, "alignment_bytes": {"$ref": "#/$defs/positive_u64"}, "persistent": {"type": "boolean"}, "buffer_index": {"$ref": "#/$defs/u64"}}},
    "view": {"type": "object", "additionalProperties": false, "required": ["kind", "view_id", "object_id", "shard_id", "shard_origin", "padded_shape", "valid_shape", "object_offset_elements", "object_strides", "generation"], "properties": {"kind": {"const": "BufferView"}, "view_id": {"$ref": "#/$defs/id"}, "object_id": {"$ref": "#/$defs/id"}, "shard_id": {"$ref": "#/$defs/id"}, "shard_origin": {"$ref": "#/$defs/shape"}, "padded_shape": {"$ref": "#/$defs/shape"}, "valid_shape": {"$ref": "#/$defs/shape"}, "object_offset_elements": {"$ref": "#/$defs/u64"}, "object_strides": {"$ref": "#/$defs/shape"}, "layout": {"$ref": "#/$defs/layout"}, "blocked_layout": {"$ref": "#/$defs/blocked_layout"}, "generation": {"$ref": "#/$defs/u64"}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["kind", "state_id", "object_id", "version", "origin", "partial_sum_id"], "properties": {"kind": {"const": "TensorState"}, "state_id": {"$ref": "#/$defs/id"}, "object_id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/u64"}, "origin": {"enum": ["EMPTY", "EXTERNAL", "PRE_RESIDENT", "PRODUCED"]}, "partial_sum_id": {"$ref": "#/$defs/id_or_zero"}}},
    "token": {"type": "object", "additionalProperties": false, "required": ["kind", "token_id", "initial"], "properties": {"kind": {"const": "ControlToken"}, "token_id": {"$ref": "#/$defs/id"}, "initial": {"type": "boolean"}}},
    "region": {"type": "object", "additionalProperties": false, "required": ["kind", "origin", "shape", "steps"], "properties": {"kind": {"const": "ElementRegion"}, "origin": {"$ref": "#/$defs/shape"}, "shape": {"$ref": "#/$defs/shape"}, "steps": {"type": "array", "items": {"$ref": "#/$defs/positive_u64"}}}},
    "read": {"type": "object", "additionalProperties": false, "required": ["kind", "state_id", "view_id", "region", "mode"], "properties": {"kind": {"const": "OperandAccess"}, "state_id": {"$ref": "#/$defs/id"}, "view_id": {"$ref": "#/$defs/id"}, "region": {"$ref": "#/$defs/region"}, "mode": {"const": "READ"}}},
    "write": {"type": "object", "additionalProperties": false, "required": ["kind", "old_state_id", "new_state_id", "view_id", "region", "mode"], "properties": {"kind": {"const": "StateTransition"}, "old_state_id": {"$ref": "#/$defs/id"}, "new_state_id": {"$ref": "#/$defs/id"}, "view_id": {"$ref": "#/$defs/id"}, "region": {"$ref": "#/$defs/region"}, "mode": {"const": "WRITE"}}},
    "tile": {"type": "object", "additionalProperties": false, "required": ["kind", "batch_origin", "m_origin", "n_origin", "k_origin", "batch_extent", "m_extent", "n_extent", "k_extent", "valid_batch", "valid_m", "valid_n", "valid_k"], "properties": {"kind": {"const": "KernelTile"}, "batch_origin": {"$ref": "#/$defs/u64"}, "m_origin": {"$ref": "#/$defs/u64"}, "n_origin": {"$ref": "#/$defs/u64"}, "k_origin": {"$ref": "#/$defs/u64"}, "batch_extent": {"$ref": "#/$defs/u64"}, "m_extent": {"$ref": "#/$defs/u64"}, "n_extent": {"$ref": "#/$defs/u64"}, "k_extent": {"$ref": "#/$defs/u64"}, "valid_batch": {"$ref": "#/$defs/u64"}, "valid_m": {"$ref": "#/$defs/u64"}, "valid_n": {"$ref": "#/$defs/u64"}, "valid_k": {"$ref": "#/$defs/u64"}}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["kind", "logical_input_bytes", "logical_output_bytes", "local_storage_bytes", "macs", "vector_ops", "reduction_ops"], "properties": {"kind": {"const": "KernelCost"}, "logical_input_bytes": {"$ref": "#/$defs/u64"}, "logical_output_bytes": {"$ref": "#/$defs/u64"}, "local_storage_bytes": {"$ref": "#/$defs/u64"}, "macs": {"$ref": "#/$defs/u64"}, "vector_ops": {"$ref": "#/$defs/u64"}, "reduction_ops": {"$ref": "#/$defs/u64"}}},
    "alloc_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "object_id"], "properties": {"kind": {"const": "AllocAttrs"}, "object_id": {"$ref": "#/$defs/id"}}},
    "view_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "view_id"], "properties": {"kind": {"const": "ViewDeclarationAttrs"}, "view_id": {"$ref": "#/$defs/id"}}},
    "dma_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "issuing_core", "source_core", "destination_core", "transfer_id", "fill_pattern"], "properties": {"kind": {"enum": [1, 2, 3, 4, 5]}, "issuing_core": {"$ref": "#/$defs/core"}, "source_core": {"$ref": "#/$defs/core"}, "destination_core": {"$ref": "#/$defs/core"}, "transfer_id": {"$ref": "#/$defs/id_or_zero"}, "fill_pattern": {"type": "string", "pattern": "^(?:[0-9a-f]{2})*$"}, "max_burst_beats": {"type": "integer", "minimum": 1, "maximum": 256}}},
    "recv_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "transfer_id", "source_core", "destination_core", "expected_bytes"], "properties": {"kind": {"const": "RecvWaitAttrs"}, "transfer_id": {"$ref": "#/$defs/id"}, "source_core": {"$ref": "#/$defs/hardware_core"}, "destination_core": {"$ref": "#/$defs/hardware_core"}, "expected_bytes": {"$ref": "#/$defs/u64"}}},
    "gemm_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "graph_opcode", "semantic_attrs", "tile", "cost", "phase", "partial_sum_id"], "properties": {"kind": {"const": "GemmKernelAttrs"}, "graph_opcode": {"enum": ["MATMUL", "BMM", "LINEAR_BIAS"]}, "semantic_attrs": {"$ref": "mesh-graph-v1#/$defs/matmul_attrs"}, "tile": {"$ref": "#/$defs/tile"}, "cost": {"$ref": "#/$defs/cost"}, "phase": {"enum": ["DIRECT", "ACCUMULATE_ONLY", "ACCUMULATE_FIRST", "ACCUMULATE_CONTINUE", "ACCUMULATE_FINAL"]}, "partial_sum_id": {"$ref": "#/$defs/id_or_zero"}}},
    "matrix_epilogue_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "graph_opcode", "semantic_attrs", "tile", "cost", "algorithm"], "properties": {"kind": {"const": "MatrixEpilogueKernelAttrs"}, "graph_opcode": {"enum": ["MATMUL", "BMM", "LINEAR_BIAS"]}, "semantic_attrs": {"$ref": "mesh-graph-v1#/$defs/matmul_attrs"}, "tile": {"$ref": "#/$defs/tile"}, "cost": {"$ref": "#/$defs/cost"}, "algorithm": {"const": "VECTOR_ACCUMULATION"}}},
    "vector_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "graph_opcode", "semantic_attrs", "tile", "cost", "algorithm"], "properties": {"kind": {"const": "VectorKernelAttrs"}, "graph_opcode": {"enum": ["ADD", "SUB", "MUL", "DIV", "RELU", "GELU", "SILU", "EXP", "RSQRT", "EMBEDDING_LOOKUP"]}, "semantic_attrs": {"oneOf": [{"$ref": "mesh-graph-v1#/$defs/elementwise_attrs"}, {"$ref": "mesh-graph-v1#/$defs/embedding_attrs"}]}, "tile": {"$ref": "#/$defs/tile"}, "cost": {"$ref": "#/$defs/cost"}, "algorithm": {"enum": ["ELEMENTWISE", "EMBEDDING_GATHER"]}}},
    "movement_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "graph_opcode", "semantic_attrs", "tile", "cost", "algorithm"], "properties": {"kind": {"const": "MovementKernelAttrs"}, "graph_opcode": {"enum": ["RESHAPE_VIEW", "TRANSPOSE_VIEW", "PERMUTE_VIEW", "SLICE_VIEW", "EXPAND_VIEW", "CONTIGUOUS_COPY", "CONCAT", "GATHER_ROWS"]}, "semantic_attrs": {"oneOf": [{"$ref": "mesh-graph-v1#/$defs/view_attrs"}, {"$ref": "mesh-graph-v1#/$defs/movement_attrs"}]}, "tile": {"$ref": "#/$defs/tile"}, "cost": {"$ref": "#/$defs/cost"}, "algorithm": {"enum": ["STRIDED_COPY", "CONCAT", "GATHER_ROWS"]}}},
