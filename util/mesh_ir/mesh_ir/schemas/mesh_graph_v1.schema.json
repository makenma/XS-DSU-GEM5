{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesh-graph-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "required_features", "arch_digest", "source_semantic_hash", "semantic_sha256", "entrypoint", "profile_id", "values", "functions", "symbols", "profile_bindings", "decomposition_digest", "debug_locations"],
  "properties": {
    "schema": {"type": "object", "additionalProperties": false, "required": ["major", "minor"], "properties": {"major": {"const": 1}, "minor": {"const": 0}}},
    "required_features": {"type": "array", "maxItems": 0, "uniqueItems": true},
    "arch_digest": {"$ref": "#/$defs/sha256"},
    "source_semantic_hash": {"$ref": "#/$defs/sha256"},
    "semantic_sha256": {"$ref": "#/$defs/sha256"},
    "entrypoint": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "values": {"type": "array", "items": {"$ref": "#/$defs/value"}},
    "functions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/function"}},
    "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}},
    "profile_bindings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["symbol_id", "value"], "properties": {"symbol_id": {"$ref": "#/$defs/id"}, "value": {"$ref": "#/$defs/u64"}}}},
    "decomposition_digest": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/sha256"}]},
    "debug_locations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_node_id", "location"], "properties": {"source_node_id": {"type": "string", "minLength": 1}, "location": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_large_u64": {"type": "string", "pattern": "^0x(?:[2-9a-f][0-9a-f]{13}|[1-9a-f][0-9a-f]{14,15})$"},
    "u64": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 9007199254740991}, {"$ref": "#/$defs/canonical_large_u64"}]},
    "positive_u64": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 9007199254740991}, {"$ref": "#/$defs/canonical_large_u64"}]},
    "signed_bound": {"oneOf": [{"type": "integer", "minimum": -9223372036854775808, "maximum": 9007199254740991}, {"$ref": "#/$defs/canonical_large_u64"}]},
    "id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "axis": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "dtype": {"type": "integer", "enum": [1, 2, 3, 4, 5]},
    "role": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6, 7]},
    "access": {"type": "integer", "enum": [1, 2]},
    "opcode": {"type": "string", "enum": ["MATMUL", "BMM", "LINEAR_BIAS", "RESHAPE_VIEW", "TRANSPOSE_VIEW", "PERMUTE_VIEW", "SLICE_VIEW", "EXPAND_VIEW", "CONTIGUOUS_COPY", "CONCAT", "GATHER_ROWS", "ADD", "SUB", "MUL", "DIV", "RELU", "GELU", "SILU", "EXP", "RSQRT", "REDUCE_SUM", "REDUCE_MAX", "REDUCE_MEAN", "LAYERNORM", "RMSNORM", "SOFTMAX", "EMBEDDING_LOOKUP"]},
    "const_dim": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "const"}, "value": {"$ref": "#/$defs/u64"}}},
    "symbol_dim": {"type": "object", "additionalProperties": false, "required": ["kind", "symbol_id", "name", "minimum", "maximum", "multiple_of"], "properties": {"kind": {"const": "symbol"}, "symbol_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "minimum": {"$ref": "#/$defs/u64"}, "maximum": {"$ref": "#/$defs/u64"}, "multiple_of": {"$ref": "#/$defs/positive_u64"}}},
    "add_dim": {"type": "object", "additionalProperties": false, "required": ["kind", "lhs", "rhs"], "properties": {"kind": {"const": "add"}, "lhs": {"$ref": "#/$defs/dim"}, "rhs": {"$ref": "#/$defs/dim"}}},
    "mul_dim": {"type": "object", "additionalProperties": false, "required": ["kind", "value", "factor"], "properties": {"kind": {"const": "mul_by_const"}, "value": {"$ref": "#/$defs/dim"}, "factor": {"$ref": "#/$defs/u64"}}},
    "floor_dim": {"type": "object", "additionalProperties": false, "required": ["kind", "value", "divisor"], "properties": {"kind": {"const": "floor_div_by_const"}, "value": {"$ref": "#/$defs/dim"}, "divisor": {"$ref": "#/$defs/positive_u64"}}},
    "ceil_dim": {"type": "object", "additionalProperties": false, "required": ["kind", "value", "divisor"], "properties": {"kind": {"const": "ceil_div_by_const"}, "value": {"$ref": "#/$defs/dim"}, "divisor": {"$ref": "#/$defs/positive_u64"}}},
    "dim": {"oneOf": [{"$ref": "#/$defs/const_dim"}, {"$ref": "#/$defs/symbol_dim"}, {"$ref": "#/$defs/add_dim"}, {"$ref": "#/$defs/mul_dim"}, {"$ref": "#/$defs/floor_dim"}, {"$ref": "#/$defs/ceil_dim"}]},
    "symbol": {"$ref": "#/$defs/symbol_dim"},
    "fixed_stride": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "fixed"}, "value": {"$ref": "#/$defs/u64"}}},
    "shape_product_stride": {"type": "object", "additionalProperties": false, "required": ["kind", "dimensions", "factor"], "properties": {"kind": {"const": "shape_product"}, "dimensions": {"type": "array", "items": {"$ref": "#/$defs/dim"}}, "factor": {"$ref": "#/$defs/u64"}}},
    "stride": {"oneOf": [{"$ref": "#/$defs/fixed_stride"}, {"$ref": "#/$defs/shape_product_stride"}]},
    "leaf_pytree": {"type": "object", "additionalProperties": false, "required": ["kind", "children", "keys"], "properties": {"kind": {"const": "leaf"}, "children": {"type": "array", "maxItems": 0}, "keys": {"type": "array", "maxItems": 0}}},
    "tuple_pytree": {"type": "object", "additionalProperties": false, "required": ["kind", "children", "keys"], "properties": {"kind": {"const": "tuple"}, "children": {"type": "array", "items": {"$ref": "#/$defs/pytree"}}, "keys": {"type": "array", "maxItems": 0}}},
    "list_pytree": {"type": "object", "additionalProperties": false, "required": ["kind", "children", "keys"], "properties": {"kind": {"const": "list"}, "children": {"type": "array", "items": {"$ref": "#/$defs/pytree"}}, "keys": {"type": "array", "maxItems": 0}}},
    "dict_pytree": {"type": "object", "additionalProperties": false, "required": ["kind", "children", "keys"], "properties": {"kind": {"const": "dict"}, "children": {"type": "array", "items": {"$ref": "#/$defs/pytree"}}, "keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
    "pytree": {"oneOf": [{"$ref": "#/$defs/leaf_pytree"}, {"$ref": "#/$defs/tuple_pytree"}, {"$ref": "#/$defs/list_pytree"}, {"$ref": "#/$defs/dict_pytree"}]},
    "matmul_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "batch_axes", "lhs_contract_axis", "rhs_contract_axis", "lhs_transpose", "rhs_transpose", "alpha", "beta", "accum_dtype"], "properties": {"kind": {"const": "MatmulAttrs"}, "batch_axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}, "uniqueItems": true}, "lhs_contract_axis": {"type": "integer"}, "rhs_contract_axis": {"type": "integer"}, "lhs_transpose": {"type": "boolean"}, "rhs_transpose": {"type": "boolean"}, "alpha": {"type": "number"}, "beta": {"type": "number"}, "accum_dtype": {"$ref": "#/$defs/dtype"}}},
    "view_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "shape", "permutation", "axes", "starts", "ends", "steps", "expanded_axes"], "properties": {"kind": {"const": "ViewAttrs"}, "shape": {"type": "array", "items": {"$ref": "#/$defs/dim"}}, "permutation": {"type": "array", "items": {"$ref": "#/$defs/axis"}, "uniqueItems": true}, "axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}, "uniqueItems": true}, "starts": {"type": "array", "items": {"$ref": "#/$defs/signed_bound"}}, "ends": {"type": "array", "items": {"$ref": "#/$defs/signed_bound"}}, "steps": {"type": "array", "items": {"$ref": "#/$defs/positive_u64"}}, "expanded_axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}, "uniqueItems": true}}},
    "movement_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "axis", "bounds_check"], "properties": {"kind": {"const": "MovementAttrs"}, "axis": {"$ref": "#/$defs/axis"}, "bounds_check": {"type": "boolean"}}},
    "elementwise_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "scalar_side", "alpha", "approximation"], "properties": {"kind": {"const": "ElementwiseAttrs"}, "scalar": {"type": ["number", "boolean"]}, "scalar_side": {"enum": ["none", "lhs", "rhs"]}, "alpha": {"type": "number"}, "approximation": {"enum": ["none", "tanh"]}}},
    "reduce_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "axes", "keepdim", "output_dtype", "accum_dtype", "order"], "properties": {"kind": {"const": "ReduceAttrs"}, "axes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/axis"}, "uniqueItems": true}, "keepdim": {"type": "boolean"}, "output_dtype": {"$ref": "#/$defs/dtype"}, "accum_dtype": {"$ref": "#/$defs/dtype"}, "order": {"const": "left_to_right"}}},
    "norm_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "axes", "epsilon", "has_weight", "has_bias"], "properties": {"kind": {"const": "NormAttrs"}, "axes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/axis"}, "uniqueItems": true}, "epsilon": {"type": "number", "minimum": 0}, "has_weight": {"type": "boolean"}, "has_bias": {"type": "boolean"}}},
    "softmax_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "axis", "output_dtype", "zero_fully_masked_rows"], "properties": {"kind": {"const": "SoftmaxAttrs"}, "axis": {"$ref": "#/$defs/axis"}, "output_dtype": {"$ref": "#/$defs/dtype"}, "zero_fully_masked_rows": {"type": "boolean"}}},
    "embedding_attrs": {"type": "object", "additionalProperties": false, "required": ["kind", "padding_idx", "scale_grad_by_freq", "sparse", "norm_type"], "properties": {"kind": {"const": "EmbeddingAttrs"}, "padding_idx": {"type": "integer"}, "scale_grad_by_freq": {"const": false}, "sparse": {"const": false}, "max_norm": {"type": "number"}, "norm_type": {"type": "number", "exclusiveMinimum": 0}}},
    "attrs": {"oneOf": [{"$ref": "#/$defs/matmul_attrs"}, {"$ref": "#/$defs/view_attrs"}, {"$ref": "#/$defs/movement_attrs"}, {"$ref": "#/$defs/elementwise_attrs"}, {"$ref": "#/$defs/reduce_attrs"}, {"$ref": "#/$defs/norm_attrs"}, {"$ref": "#/$defs/softmax_attrs"}, {"$ref": "#/$defs/embedding_attrs"}]},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_id", "name", "role", "dtype", "shape", "strides", "storage_offset", "alias_root", "access"],
      "properties": {
        "value_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "role": {"$ref": "#/$defs/role"}, "dtype": {"$ref": "#/$defs/dtype"},
        "shape": {"type": "array", "items": {"$ref": "#/$defs/dim"}}, "strides": {"type": "array", "items": {"$ref": "#/$defs/stride"}}, "storage_offset": {"$ref": "#/$defs/u64"}, "alias_root": {"$ref": "#/$defs/id"}, "access": {"$ref": "#/$defs/access"},
        "logical_extent_bytes": {"$ref": "#/$defs/u64"}, "storage_extent_bytes": {"$ref": "#/$defs/u64"}, "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op_id", "opcode", "operands", "results", "attrs", "source_node_id"],
      "properties": {"op_id": {"$ref": "#/$defs/id"}, "opcode": {"$ref": "#/$defs/opcode"}, "operands": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "results": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/id"}}, "attrs": {"$ref": "#/$defs/attrs"}, "source_node_id": {"type": "string", "minLength": 1}},
      "allOf": [
        {"if": {"properties": {"opcode": {"enum": ["MATMUL", "BMM", "LINEAR_BIAS"]}}, "required": ["opcode"]}, "then": {"properties": {"attrs": {"$ref": "#/$defs/matmul_attrs"}}}},
        {"if": {"properties": {"opcode": {"enum": ["RESHAPE_VIEW", "TRANSPOSE_VIEW", "PERMUTE_VIEW", "SLICE_VIEW", "EXPAND_VIEW", "CONTIGUOUS_COPY"]}}, "required": ["opcode"]}, "then": {"properties": {"attrs": {"$ref": "#/$defs/view_attrs"}}}},
        {"if": {"properties": {"opcode": {"enum": ["CONCAT", "GATHER_ROWS"]}}, "required": ["opcode"]}, "then": {"properties": {"attrs": {"$ref": "#/$defs/movement_attrs"}}}},
        {"if": {"properties": {"opcode": {"enum": ["ADD", "SUB", "MUL", "DIV", "RELU", "GELU", "SILU", "EXP", "RSQRT"]}}, "required": ["opcode"]}, "then": {"properties": {"attrs": {"$ref": "#/$defs/elementwise_attrs"}}}},
        {"if": {"properties": {"opcode": {"enum": ["REDUCE_SUM", "REDUCE_MAX", "REDUCE_MEAN"]}}, "required": ["opcode"]}, "then": {"properties": {"attrs": {"$ref": "#/$defs/reduce_attrs"}}}},
        {"if": {"properties": {"opcode": {"enum": ["LAYERNORM", "RMSNORM"]}}, "required": ["opcode"]}, "then": {"properties": {"attrs": {"$ref": "#/$defs/norm_attrs"}}}},
        {"if": {"properties": {"opcode": {"const": "SOFTMAX"}}, "required": ["opcode"]}, "then": {"properties": {"attrs": {"$ref": "#/$defs/softmax_attrs"}}}},
        {"if": {"properties": {"opcode": {"const": "EMBEDDING_LOOKUP"}}, "required": ["opcode"]}, "then": {"properties": {"attrs": {"$ref": "#/$defs/embedding_attrs"}}}}
      ]
    },
    "function": {"type": "object", "additionalProperties": false, "required": ["function_id", "name", "inputs", "ops", "outputs", "input_pytree", "output_pytree"], "properties": {"function_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1}, "inputs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "ops": {"type": "array", "items": {"$ref": "#/$defs/op"}}, "outputs": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "input_pytree": {"$ref": "#/$defs/pytree"}, "output_pytree": {"$ref": "#/$defs/pytree"}}}
  }
}
