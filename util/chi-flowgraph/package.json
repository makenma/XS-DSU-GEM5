  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.15",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.3",
    "typescript": "5.9.2",
