// Project Zicbom execution support for the pinned KMH gem5.
// These instructions use normal CPU translation, LSQ and cache maintenance
// packets. No CHI opcode is selected in the ISA implementation.
// Full-system execution observes the privilege-specific xenvcfg controls.
def template CboDeclare {{
    class %(class_name)s : public MemInst
    {
      private:
        %(reg_idx_arr_decl)s;
      public:
        %(class_name)s(ExtMachInst machInst);
        Fault execute(ExecContext *, Trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, Trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *, Trace::InstRecord *) const override;
        std::string generateDisassembly(Addr, const loader::SymbolTable *) const override;
    };
}};

def template CboConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : MemInst("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
        memAccessFlags = %(maintenance_flags)s | Request::DST_POC | Request::STRICT_ORDER;
    }
    std::string
    %(class_name)s::generateDisassembly(Addr, const loader::SymbolTable *) const
    {
        std::stringstream ss;
        ss << mnemonic << " (" << registerName(srcRegIdx(0)) << ')';
        return ss.str();
    }
}};

def template CboExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc, Trace::InstRecord *traceData) const
    {
        return initiateAcc(xc, traceData);
    }
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc, Trace::InstRecord *traceData) const
    {
        auto flags = memAccessFlags;
        if (FullSystem) {
            const auto op = !(flags & Request::CLEAN) ? Cbo::Operation::Invalidate :
                flags & Request::INVALIDATE ? Cbo::Operation::Flush : Cbo::Operation::Clean;
            const auto decision = Cbo::permission(op,
                xc->tcBase()->readMiscRegNoEffect(MISCREG_PRV),
                xc->tcBase()->readMiscRegNoEffect(MISCREG_VIRMODE),
                xc->tcBase()->readMiscRegNoEffect(MISCREG_MENVCFG),
                xc->tcBase()->readMiscRegNoEffect(MISCREG_HENVCFG),
                xc->tcBase()->readMiscRegNoEffect(MISCREG_SENVCFG));
            if (decision == Cbo::Decision::IllegalInstruction)
                return std::make_shared<IllegalInstFault>("Zicbom disabled by xenvcfg", machInst);
            if (decision == Cbo::Decision::VirtualInstruction)
                return std::make_shared<HVFault>();
            if (decision == Cbo::Decision::Flush)
                flags.set(Request::CLEAN | Request::INVALIDATE);
        }
        %(op_decl)s;
        %(op_rd)s;
        // Translate the actual rs1 byte: CBO has no alignment exception, and
        // a translation/access fault must retain rs1 in tval. Classic caches
        // and native L2 select the containing block with getBlockAddr().
        const Addr EA = Rs1;
        return xc->writeMem(nullptr, 1, EA, flags, nullptr,
                            std::vector<bool>(1, true));
    }
    Fault
    %(class_name)s::completeAcc(PacketPtr, ExecContext *, Trace::InstRecord *) const
    {
        return NoFault;
    }
}};

def format CboOp(maintenance_flags) {{
    iop = InstObjParams(name, Name, 'MemInst',
        {'code': 'const Addr EA = Rs1;', 'maintenance_flags': maintenance_flags},
        ['IsStore', 'IsNonSpeculative', 'IsSerializeBefore', 'IsSerializeAfter', 'MemWriteOp'])
    header_output = CboDeclare.subst(iop)
    decoder_output = CboConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = CboExecute.subst(iop)
}};
