{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moe_correlated_profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "route_window_tokens",
    "layers",
    "route_profile_digest"
  ],
  "properties": {
    "schema": {"const": "moe_correlated_profile_v1"},
    "version": {"const": 1},
    "route_window_tokens": {"type": "integer", "minimum": 1},
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/layer"}
    },
    "route_profile_digest": {"$ref": "#/$defs/hex64"}
  },
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "u64Json": {
      "anyOf": [
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"type": "string", "pattern": "^0x[0-9a-f]{16}$"}
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "window_ordinal",
        "base_weights_q32",
        "hotset",
        "source_bias_q16",
        "hotset_boost_q16",
        "sticky_expert_boost_q16"
      ],
      "properties": {
        "phase": {"type": "integer", "minimum": 1, "maximum": 3},
        "window_ordinal": {"$ref": "#/$defs/u64Json"},
        "base_weights_q32": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/u64Json"}
        },
        "hotset": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0, "maximum": 65535}
        },
        "source_bias_q16": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 0,
                      "maximum": 4294967295}
          }
        },
        "hotset_boost_q16": {"type": "integer", "minimum": 0,
                             "maximum": 4294967295},
        "sticky_expert_boost_q16": {"type": "integer", "minimum": 0,
                                    "maximum": 4294967295}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_id", "expert_count", "top_k", "windows"],
      "properties": {
        "layer_id": {"type": "integer", "minimum": 1},
        "expert_count": {"type": "integer", "minimum": 1},
        "top_k": {"type": "integer", "minimum": 1},
        "windows": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/window"}
        }
      }
    }
  }
}
