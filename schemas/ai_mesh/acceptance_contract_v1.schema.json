{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gem5.org/schemas/ai_mesh/acceptance_contract_v1.schema.json",
  "$defs": {
    "u16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "i32": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "u64Json": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{16}$"
        }
      ]
    },
    "positiveU64Json": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{16}$"
        }
      ]
    },
    "lowerHex": {
      "type": "string",
      "pattern": "^[0-9a-f]+$"
    },
    "lowerHex40": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "lowerHex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "detailCode": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^E_[A-Z0-9_]+$"
        },
        "value": {
          "$ref": "#/$defs/u32"
        }
      },
      "required": [
        "symbol",
        "value"
      ],
      "additionalProperties": false
    },
    "ledgers": {
      "type": "object",
      "properties": {
        "live_cq_obligations": {
          "$ref": "#/$defs/u32"
        },
        "fatal_cq_obligations": {
          "$ref": "#/$defs/u32"
        },
        "fatal_sq_intakes": {
          "$ref": "#/$defs/u32"
        },
        "fatal_publications": {
          "$ref": "#/$defs/u32"
        },
        "ambiguous_publications": {
          "$ref": "#/$defs/u32"
        },
        "host_ack_wait_b": {
          "$ref": "#/$defs/u32"
        },
        "host_ack_b_error": {
          "$ref": "#/$defs/u32"
        },
        "msi_rob_entries": {
          "$ref": "#/$defs/u32"
        },
        "fatal_records": {
          "$ref": "#/$defs/u32"
        }
      },
      "required": [
        "live_cq_obligations",
        "fatal_cq_obligations",
        "fatal_sq_intakes",
        "fatal_publications",
        "ambiguous_publications",
        "host_ack_wait_b",
        "host_ack_b_error",
        "msi_rob_entries",
        "fatal_records"
      ],
      "additionalProperties": false
    },
    "artifactKind": {
      "enum": [
        "SUMMARY_JSON",
        "JUNIT_XML",
        "RUN_MANIFEST",
        "INVARIANTS_JSON",
        "TRAFFIC_JSON",
        "TRACE_MIN",
        "WAIT_FOR_GRAPH",
        "FATAL_SNAPSHOT",
        "GATE3_OBSERVATION_JSON",
        "GATE4_OBSERVATION_JSON"
      ]
    },
    "unitTimeout": {
      "type": "object",
      "properties": {
        "sim_ticks": {
          "type": "null"
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "sim_ticks",
        "wall_seconds"
      ],
      "additionalProperties": false
    },
    "gem5Timeout": {
      "type": "object",
      "properties": {
        "sim_ticks": {
          "$ref": "#/$defs/positiveU64Json"
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "sim_ticks",
        "wall_seconds"
      ],
      "additionalProperties": false
    },
    "gtestExecution": {
      "type": "object",
      "properties": {
        "runner": {
          "const": "GTEST"
        },
        "binary_target": {
          "const": "UNITTESTS_OPT"
        },
        "gtest_filter": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(/[0-9]+)?\\.[A-Za-z_][A-Za-z0-9_]*(/[0-9]+)?$"
        }
      },
      "required": [
        "runner",
        "binary_target",
        "gtest_filter"
      ],
      "additionalProperties": false
    },
    "pytestExecution": {
      "type": "object",
      "properties": {
        "runner": {
          "const": "PYTEST"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[^\\s:]+::[^\\s:]+$"
        }
      },
      "required": [
        "runner",
        "node_id"
      ],
      "additionalProperties": false
    },
    "gem5Execution": {
      "type": "object",
      "properties": {
        "runner": {
          "const": "GEM5"
        },
        "config_script": {
          "enum": [
            "configs/example/ai_mesh/run_dummy_core_agent.py",
            "configs/example/ai_mesh/run_gate3_protocol.py",
            "configs/example/ai_mesh/run_gate4_agent.py"
          ]
        },
        "case_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "runner",
        "config_script",
        "case_name",
        "args"
      ],
      "additionalProperties": false
    },
    "execution": {
      "oneOf": [
        {
          "$ref": "#/$defs/gtestExecution"
        },
        {
          "$ref": "#/$defs/pytestExecution"
        },
        {
          "$ref": "#/$defs/gem5Execution"
        }
      ]
    },
    "subcase": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "terminal_class": {
          "enum": [
            "QUIESCENT_SUCCESS",
            "EXPECTED_INFRA_FATAL"
          ]
        },
        "expected_exit_reason": {
          "enum": [
            "QUIESCENT_SUCCESS",
            "INFRA_FATAL"
          ]
        },
        "expected_first_fatal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/detailCode"
            }
          ]
        },
        "expected_ledgers": {
          "$ref": "#/$defs/ledgers"
        },
        "timeout": {
          "oneOf": [
            {
              "$ref": "#/$defs/unitTimeout"
            },
            {
              "$ref": "#/$defs/gem5Timeout"
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactKind"
          }
        },
        "execution": {
          "$ref": "#/$defs/execution"
        }
      },
      "required": [
        "name",
        "terminal_class",
        "expected_exit_reason",
        "expected_first_fatal",
        "expected_ledgers",
        "timeout",
        "artifacts",
        "execution"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "terminal_class": {
                "const": "QUIESCENT_SUCCESS"
              }
            },
            "required": [
              "terminal_class"
            ]
          },
          "then": {
            "properties": {
              "expected_exit_reason": {
                "const": "QUIESCENT_SUCCESS"
              },
              "expected_first_fatal": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "expected_exit_reason": {
                "const": "INFRA_FATAL"
              },
              "expected_first_fatal": {
                "$ref": "#/$defs/detailCode"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution": {
                "properties": {
                  "runner": {
                    "const": "GEM5"
                  }
                },
                "required": [
                  "runner"
                ]
              }
            },
            "required": [
              "execution"
            ]
          },
          "then": {
            "properties": {
              "timeout": {
                "$ref": "#/$defs/gem5Timeout"
              }
            }
          },
          "else": {
            "properties": {
              "timeout": {
                "$ref": "#/$defs/unitTimeout"
              }
            }
          }
        }
      ]
    },
    "manifestCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(DC-([1-9]|[12][0-9]|3[0-5])|MOE-([1-9]|[12][0-9]|30)|PROTO-([1-9]|[12][0-9]|30)|HOST-([1-9]|1[0-9]|2[0-6])|SERV-([1-9]|1[0-9]|2[01])|E2E-[A-H])$"
        },
        "earliest_gate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "subcases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/subcase"
          }
        }
      },
      "required": [
        "id",
        "earliest_gate",
        "subcases"
      ],
      "additionalProperties": false
    },
    "mandatoryManifest": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "ai_mesh_mandatory_manifest_v1"
        },
        "version": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "minItems": 150,
          "maxItems": 150,
          "items": {
            "$ref": "#/$defs/manifestCase"
          }
        }
      },
      "required": [
        "schema",
        "version",
        "cases"
      ],
      "additionalProperties": false
    },
    "childReport": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "ai_mesh_child_scenario_report_v1"
        },
        "version": {
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "subcase": {
          "type": "string"
        },
        "run_exit_reason": {
          "enum": [
            "QUIESCENT_SUCCESS",
            "INFRA_FATAL",
            "WATCHDOG",
            "TEST_ASSERTION_FAILED",
            "CONFIG_ERROR",
            "INTERNAL_ABORT"
          ]
        },
        "first_fatal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/detailCode"
            }
          ]
        },
        "watchdog_fired": {
          "type": "boolean"
        },
        "ledger_summary": {
          "$ref": "#/$defs/ledgers"
        },
        "global_quiescence": {
          "type": "boolean"
        },
        "run_manifest_digest": {
          "$ref": "#/$defs/lowerHex64"
        }
      },
      "required": [
        "schema",
        "version",
        "id",
        "subcase",
        "run_exit_reason",
        "first_fatal",
        "watchdog_fired",
        "ledger_summary",
        "global_quiescence",
        "run_manifest_digest"
      ],
      "additionalProperties": false
    },
    "childTermination": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "EXIT"
            },
            "exit_code": {
              "$ref": "#/$defs/i32"
            },
            "signal": {
              "type": "null"
            }
          },
          "required": [
            "kind",
            "exit_code",
            "signal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "SIGNAL"
            },
            "exit_code": {
              "type": "null"
            },
            "signal": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "kind",
            "exit_code",
            "signal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "SPAWN_ERROR",
                "WALL_TIMEOUT"
              ]
            },
            "exit_code": {
              "type": "null"
            },
            "signal": {
              "type": "null"
            }
          },
          "required": [
            "kind",
            "exit_code",
            "signal"
          ],
          "additionalProperties": false
        }
      ]
    },
    "artifactPath": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/artifactKind"
        },
        "state": {
          "enum": [
            "AVAILABLE",
            "MISSING"
          ]
        },
        "path": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
            }
          ]
        }
      },
      "required": [
        "kind",
        "state",
        "path"
      ],
      "additionalProperties": false
    },
    "runSummary": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "ai_mesh_run_summary_v1"
        },
        "version": {
          "const": 1
        },
        "id": {
          "type": "string"
        },
        "subcase": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "terminal_class": {
          "enum": [
            "QUIESCENT_SUCCESS",
            "EXPECTED_INFRA_FATAL"
          ]
        },
        "run_exit_reason": {
          "enum": [
            "QUIESCENT_SUCCESS",
            "INFRA_FATAL",
            "WATCHDOG",
            "TEST_ASSERTION_FAILED",
            "CONFIG_ERROR",
            "INTERNAL_ABORT",
            "HARNESS_FAILURE"
          ]
        },
        "process_exit_code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/i32"
            }
          ]
        },
        "child_termination": {
          "$ref": "#/$defs/childTermination"
        },
        "harness_failure_kind": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "SPAWN_ERROR",
                "SIGNAL",
                "WALL_TIMEOUT",
                "MISSING_CHILD_REPORT",
                "INVALID_CHILD_REPORT",
                "EXIT_REPORT_MISMATCH",
                "ARTIFACT_ERROR"
              ]
            }
          ]
        },
        "first_fatal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/detailCode"
            }
          ]
        },
        "watchdog_fired": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ledger_summary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ledgers"
            }
          ]
        },
        "global_quiescence": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "run_manifest_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/lowerHex64"
            }
          ]
        },
        "normalized_execution_digest": {
          "$ref": "#/$defs/lowerHex64"
        },
        "artifact_paths": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifactPath"
          }
        }
      },
      "required": [
        "schema",
        "version",
        "id",
        "subcase",
        "status",
        "terminal_class",
        "run_exit_reason",
        "process_exit_code",
        "child_termination",
        "harness_failure_kind",
        "first_fatal",
        "watchdog_fired",
        "ledger_summary",
        "global_quiescence",
        "run_manifest_digest",
        "normalized_execution_digest",
        "artifact_paths"
      ],
      "additionalProperties": false
    },
    "environmentEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false
    },
    "inheritedEnvironmentEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sha256_of_value": {
          "$ref": "#/$defs/lowerHex64"
        }
      },
      "required": [
        "name",
        "sha256_of_value"
      ],
      "additionalProperties": false
    },
    "unitScenario": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "UNIT"
        },
        "unit_registry_digest": {
          "$ref": "#/$defs/lowerHex64"
        }
      },
      "required": [
        "kind",
        "unit_registry_digest"
      ],
      "additionalProperties": false
    },
    "nullableDigest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/lowerHex64"
        }
      ]
    },
    "gem5Digests": {
      "type": "object",
      "properties": {
        "configuration": {
          "$ref": "#/$defs/lowerHex64"
        },
        "base_architecture": {
          "$ref": "#/$defs/lowerHex64"
        },
        "effective_architecture": {
          "$ref": "#/$defs/lowerHex64"
        },
        "program_weight_registry": {
          "$ref": "#/$defs/nullableDigest"
        },
        "model_weight_image": {
          "$ref": "#/$defs/nullableDigest"
        },
        "workload_plan": {
          "$ref": "#/$defs/nullableDigest"
        },
        "control_plan": {
          "$ref": "#/$defs/nullableDigest"
        },
        "command_identity": {
          "$ref": "#/$defs/lowerHex64"
        },
        "host_arena_object_plan": {
          "$ref": "#/$defs/nullableDigest"
        },
        "capacity_plan": {
          "$ref": "#/$defs/nullableDigest"
        },
        "endpoint_map": {
          "$ref": "#/$defs/nullableDigest"
        },
        "host_task_identity": {
          "$ref": "#/$defs/nullableDigest"
        }
      },
      "required": [
        "configuration",
        "base_architecture",
        "effective_architecture",
        "program_weight_registry",
        "model_weight_image",
        "workload_plan",
        "control_plan",
        "command_identity",
        "host_arena_object_plan",
        "capacity_plan",
        "endpoint_map",
        "host_task_identity"
      ],
      "additionalProperties": false
    },
    "programIdentity": {
      "type": "object",
      "properties": {
        "program_id": {
          "$ref": "#/$defs/u16"
        },
        "semantic_digest": {
          "$ref": "#/$defs/lowerHex64"
        },
        "file_sha256": {
          "$ref": "#/$defs/lowerHex64"
        }
      },
      "required": [
        "program_id",
        "semantic_digest",
        "file_sha256"
      ],
      "additionalProperties": false
    },
    "identityCounters": {
      "type": "object",
      "properties": {
        "next_serving_batch_id": {
          "$ref": "#/$defs/u64Json"
        },
        "next_program_instance_id": {
          "$ref": "#/$defs/u64Json"
        },
        "next_cache_reservation_token_id": {
          "$ref": "#/$defs/u64Json"
        },
        "next_intake_id": {
          "$ref": "#/$defs/u64Json"
        },
        "next_publication_id": {
          "$ref": "#/$defs/u64Json"
        },
        "next_sq_ar_issue_ordinal": {
          "$ref": "#/$defs/u64Json"
        }
      },
      "required": [
        "next_serving_batch_id",
        "next_program_instance_id",
        "next_cache_reservation_token_id",
        "next_intake_id",
        "next_publication_id",
        "next_sq_ar_issue_ordinal"
      ],
      "additionalProperties": false
    },
    "physicalSourceCounter": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "component_kind": {
          "type": "string",
          "minLength": 1
        },
        "component_local_id": {
          "$ref": "#/$defs/u32"
        },
        "endpoint_id": {
          "$ref": "#/$defs/u32"
        },
        "next_ordinal": {
          "$ref": "#/$defs/u64Json"
        }
      },
      "required": [
        "kind",
        "component_kind",
        "component_local_id",
        "endpoint_id",
        "next_ordinal"
      ],
      "additionalProperties": false
    },
    "hostTaskTick": {
      "type": "object",
      "properties": {
        "host_task_id": {
          "$ref": "#/$defs/u32"
        },
        "nominal_ticks": {
          "$ref": "#/$defs/u64Json"
        },
        "local_io_ticks": {
          "$ref": "#/$defs/u64Json"
        }
      },
      "required": [
        "host_task_id",
        "nominal_ticks",
        "local_io_ticks"
      ],
      "additionalProperties": false
    },
    "tickProjection": {
      "type": "object",
      "properties": {
        "host_clock_period_ticks": {
          "$ref": "#/$defs/u64Json"
        },
        "npu_clock_period_ticks": {
          "$ref": "#/$defs/u64Json"
        },
        "core_clock_period_ticks": {
          "$ref": "#/$defs/u64Json"
        },
        "host_tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hostTaskTick"
          }
        }
      },
      "required": [
        "host_clock_period_ticks",
        "npu_clock_period_ticks",
        "core_clock_period_ticks",
        "host_tasks"
      ],
      "additionalProperties": false
    },
    "approximation": {
      "type": "object",
      "properties": {
        "reference_compute": {
          "const": false
        },
        "numeric_compute": {
          "const": false
        },
        "cpu_instruction_simulation": {
          "const": false
        },
        "cpu_mesh_simulation": {
          "const": false
        },
        "ucie_protocol_simulation": {
          "const": false
        },
        "remote_link_is_analytic_proxy": {
          "const": true
        },
        "synthetic_weight_bytes": {
          "const": true
        },
