{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capacity_plan_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "workload_plan_digest",
    "control_plan_digest",
    "release_policy",
    "counts",
    "required",
    "configured",
    "headroom",
    "capacity_plan_digest"
  ],
  "properties": {
    "schema": {"const": "capacity_plan_v1"},
    "version": {"const": 1},
    "workload_plan_digest": {"$ref": "#/$defs/hex64"},
    "control_plan_digest": {"$ref": "#/$defs/hex64"},
    "release_policy": {"enum": ["AUTO_PER_TASK", "EXPLICIT_ONLY"]},
    "counts": {"$ref": "#/$defs/counts"},
    "required": {"$ref": "#/$defs/capacityVector"},
    "configured": {"$ref": "#/$defs/capacityVector"},
    "headroom": {"$ref": "#/$defs/capacityVector"},
    "capacity_plan_digest": {"$ref": "#/$defs/hex64"}
  },
  "$defs": {
    "u64Json": {
      "anyOf": [
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"type": "string", "pattern": "^0x[0-9a-f]{16}$"}
      ]
    },
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "U", "G", "C", "L", "A", "Q", "S", "T", "O", "H", "K", "ML",
        "live_context_bound"
      ],
      "properties": {
        "U": {"$ref": "#/$defs/u64Json"},
        "G": {"$ref": "#/$defs/u64Json"},
        "C": {"$ref": "#/$defs/u64Json"},
        "L": {"$ref": "#/$defs/u64Json"},
        "A": {"$ref": "#/$defs/u64Json"},
        "Q": {"$ref": "#/$defs/u64Json"},
        "S": {"$ref": "#/$defs/u64Json"},
        "T": {"$ref": "#/$defs/u64Json"},
        "O": {"$ref": "#/$defs/u64Json"},
        "H": {"$ref": "#/$defs/u64Json"},
        "K": {"$ref": "#/$defs/u64Json"},
        "ML": {"$ref": "#/$defs/u64Json"},
        "live_context_bound": {"$ref": "#/$defs/u64Json"}
      }
    },
    "globalVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sq_entries",
        "cq_entries",
        "max_inflight_msi_writes",
        "max_active_sequences",
        "max_request_contexts",
        "sq_intake_slots",
        "cq_obligation_entries",
        "terminal_result_queue_depth",
        "driver_submission_table_entries",
        "early_completion_cache_entries",
        "max_pending_sq_publications",
        "max_sq_entries_per_publication",
        "host_ack_response_entries",
        "early_cq_ack_entries",
        "sq_submit_ready_queue_entries",
        "control_trigger_queue_entries",
        "irq_queue_entries",
        "completion_read_queue_entries",
        "cancel_join_entries",
        "standalone_control_waiter_entries",
        "seen_request_id_entries",
        "host_issued_request_id_entries",
        "batch_failure_record_entries",
        "global_host_tokens",
        "kv_session_record_entries",
        "kv_session_tombstone_entries",
        "kv_admission_wait_entries",
        "cache_reservation_queue_entries",
        "instance_view_buffer_depth",
        "instance_view_ref_buffer_depth",
        "npu_session_release_waiter_entries",
        "host_release_waiter_entries",
        "host_admission_registry_entries",
        "agent_object_table_entries",
        "agent_local_store_queue_entries",
        "agent_target_request_queue_entries",
        "agent_target_response_queue_entries",
        "agent_proxy_to_npu_queue_entries",
        "agent_proxy_to_agent_queue_entries"
      ],
      "properties": {
        "sq_entries": {"$ref": "#/$defs/u64Json"},
        "cq_entries": {"$ref": "#/$defs/u64Json"},
        "max_inflight_msi_writes": {"$ref": "#/$defs/u64Json"},
        "max_active_sequences": {"$ref": "#/$defs/u64Json"},
        "max_request_contexts": {"$ref": "#/$defs/u64Json"},
        "sq_intake_slots": {"$ref": "#/$defs/u64Json"},
        "cq_obligation_entries": {"$ref": "#/$defs/u64Json"},
        "terminal_result_queue_depth": {"$ref": "#/$defs/u64Json"},
        "driver_submission_table_entries": {"$ref": "#/$defs/u64Json"},
        "early_completion_cache_entries": {"$ref": "#/$defs/u64Json"},
        "max_pending_sq_publications": {"$ref": "#/$defs/u64Json"},
        "max_sq_entries_per_publication": {"$ref": "#/$defs/u64Json"},
        "host_ack_response_entries": {"$ref": "#/$defs/u64Json"},
        "early_cq_ack_entries": {"$ref": "#/$defs/u64Json"},
        "sq_submit_ready_queue_entries": {"$ref": "#/$defs/u64Json"},
        "control_trigger_queue_entries": {"$ref": "#/$defs/u64Json"},
        "irq_queue_entries": {"$ref": "#/$defs/u64Json"},
        "completion_read_queue_entries": {"$ref": "#/$defs/u64Json"},
        "cancel_join_entries": {"$ref": "#/$defs/u64Json"},
        "standalone_control_waiter_entries": {"$ref": "#/$defs/u64Json"},
        "seen_request_id_entries": {"$ref": "#/$defs/u64Json"},
        "host_issued_request_id_entries": {"$ref": "#/$defs/u64Json"},
        "batch_failure_record_entries": {"$ref": "#/$defs/u64Json"},
        "global_host_tokens": {"$ref": "#/$defs/u64Json"},
        "kv_session_record_entries": {"$ref": "#/$defs/u64Json"},
        "kv_session_tombstone_entries": {"$ref": "#/$defs/u64Json"},
        "kv_admission_wait_entries": {"$ref": "#/$defs/u64Json"},
        "cache_reservation_queue_entries": {"$ref": "#/$defs/u64Json"},
        "instance_view_buffer_depth": {"$ref": "#/$defs/u64Json"},
        "instance_view_ref_buffer_depth": {"$ref": "#/$defs/u64Json"},
        "npu_session_release_waiter_entries": {"$ref": "#/$defs/u64Json"},
        "host_release_waiter_entries": {"$ref": "#/$defs/u64Json"},
        "host_admission_registry_entries": {"$ref": "#/$defs/u64Json"},
        "agent_object_table_entries": {"$ref": "#/$defs/u64Json"},
        "agent_local_store_queue_entries": {"$ref": "#/$defs/u64Json"},
        "agent_target_request_queue_entries": {"$ref": "#/$defs/u64Json"},
        "agent_target_response_queue_entries": {"$ref": "#/$defs/u64Json"},
        "agent_proxy_to_npu_queue_entries": {"$ref": "#/$defs/u64Json"},
        "agent_proxy_to_agent_queue_entries": {"$ref": "#/$defs/u64Json"}
      }
    },
    "servicePoolVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["COMPILE", "TEST", "LOG_PARSE"],
      "properties": {
        "COMPILE": {"$ref": "#/$defs/servicePool"},
        "TEST": {"$ref": "#/$defs/servicePool"},
        "LOG_PARSE": {"$ref": "#/$defs/servicePool"}
      }
    },
    "servicePool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots", "queue_depth"],
      "properties": {
        "slots": {"$ref": "#/$defs/u64Json"},
        "queue_depth": {"$ref": "#/$defs/u64Json"}
      }
    },
    "capacityVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global", "service_pools", "per_core", "per_instance_profile"],
      "properties": {
        "global": {"$ref": "#/$defs/globalVector"},
        "service_pools": {"$ref": "#/$defs/servicePoolVector"},
        "per_core": {"type": "array", "items": {"type": "object"}},
        "per_instance_profile": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
