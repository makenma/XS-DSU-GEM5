{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moe_histogram_replay.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "workload_plan_digest",
    "mesh_program_digest",
    "route_window_tokens",
    "layers",
    "records",
    "route_profile_digest"
  ],
  "properties": {
    "schema": {"const": "moe_histogram_replay_v1"},
    "version": {"const": 1},
    "workload_plan_digest": {"$ref": "#/$defs/hex64"},
    "mesh_program_digest": {"$ref": "#/$defs/hex64"},
    "route_window_tokens": {"type": "integer", "minimum": 1},
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/layerRegistry"}
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    },
    "route_profile_digest": {"$ref": "#/$defs/hex64"}
  },
  "$defs": {
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "u64Json": {
      "anyOf": [
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"type": "string", "pattern": "^0x[0-9a-f]{16}$"}
      ]
    },
    "layerRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_id", "expert_count", "top_k"],
      "properties": {
        "layer_id": {"type": "integer", "minimum": 1},
        "expert_count": {"type": "integer", "minimum": 1},
        "top_k": {"type": "integer", "minimum": 1}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_id",
        "phase",
        "window_ordinal",
        "population_digest",
        "source_token_counts",
        "source_expert_counts"
      ],
      "properties": {
        "layer_id": {"type": "integer", "minimum": 1},
        "phase": {"type": "integer", "minimum": 1, "maximum": 3},
        "window_ordinal": {"$ref": "#/$defs/u64Json"},
        "population_digest": {"$ref": "#/$defs/hex64"},
        "source_token_counts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/u64Json"}
        },
        "source_expert_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/u64Json"}
          }
        }
      }
    }
  }
}
